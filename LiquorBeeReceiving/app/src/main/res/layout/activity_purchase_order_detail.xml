<?xml version="1.0" encoding="utf-8"?>
<!-- The header content scrolls in its own ScrollView (rarely needed, it's short) and the line
     items get a dedicated 0dp/weight=1 region below with their own native RecyclerView scrolling -
     a RecyclerView with wrap_content height nested inside a ScrollView is a well-known fragile
     Android pattern (it measured/rendered only the first couple of items and never scrolled
     further); giving it real, explicit height instead of relying on nested-scroll measurement
     fixes that at the root instead of patching around it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/purple_primary"
        android:padding="12dp">
        <TextView
            android:id="@+id/textBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="24sp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Purchase Order"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/scanReviewPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:visibility="gone" android:background="#FFF3E0">
        <TextView android:id="@+id/textScanReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#713F12" />
        <Button android:id="@+id/buttonReviewScan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Review scan" android:textAllCaps="false" />
    </LinearLayout>
    <ScrollView android:id="@+id/orderDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textLoadError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C62828"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/detailToggleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/textVendorOrder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/purple_primary" />
                    <TextView
                        android:id="@+id/textStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:id="@+id/detailChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9662;"
                        android:textColor="@color/purple_primary"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:rotation="180" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/textStatusLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check #" android:textSize="10sp" android:textColor="#888888" />
                        <EditText android:id="@+id/editCheckNumber" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <Button android:id="@+id/buttonSaveCheckNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom" android:text="Save #" android:textSize="11sp" android:background="@drawable/bg_button_muted" android:textColor="@color/white" />
                </LinearLayout>



                <Button
                    android:id="@+id/buttonMoreOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="More Options"
                    android:textSize="11sp"
                    style="?android:attr/buttonStyleSmall"
                    android:background="@drawable/bg_button_dark"
                    android:textColor="@color/white" />



                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2. Item matches &amp; prices"
            android:textStyle="bold"
            android:textColor="@color/purple_dark" />
        <Button android:id="@+id/buttonExpandItems" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expand items" android:textAllCaps="false" android:textSize="12sp" android:visibility="gone" />
        <Button
            android:id="@+id/buttonAddItem"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Item"
            android:textSize="12sp"
            android:background="@drawable/bg_button_muted"
            android:textColor="@color/white"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Hidden until "+ Add Item" is tapped - same pattern as the OCR-staged invoice detail
         screen's Add Item, just posting to Products/AddInvoiceLine (a real InvoiceLines row)
         instead of InvoiceOcrScan/AddStagedLineItem. -->
    <LinearLayout
        android:id="@+id/addItemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/editItemSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search by name, code, or UPC" />
        <LinearLayout
            android:id="@+id/itemSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/screen_background" />
    </LinearLayout>

    <LinearLayout android:id="@+id/invoiceReviewFilters" android:visibility="gone" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp">
        <Button android:id="@+id/buttonNeedsReview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Needs review" android:textAllCaps="false" android:textSize="12sp" />
        <Button android:id="@+id/buttonAllItems" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="All items" android:textAllCaps="false" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp">
      <EditText android:id="@+id/editInvoiceSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Code, name or barcode — all pages" android:singleLine="true" android:textSize="13sp" android:imeOptions="actionSearch" android:inputType="text" />
      <Button android:id="@+id/buttonInvoiceSearch" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Search" android:textAllCaps="false" />
      <Button android:id="@+id/buttonClearInvoiceSearch" android:layout_width="48dp" android:layout_height="48dp" android:text="×" android:contentDescription="Clear invoice search" android:visibility="gone" android:minWidth="0dp" android:padding="0dp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:text="Tap an item name to correct the scan. Swipe sideways for prices and more columns." android:textSize="11sp" android:textColor="#687386" />
    <HorizontalScrollView android:id="@+id/invoiceTableScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="horizontal">
      <LinearLayout android:layout_width="1730dp" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/invoice_table_header" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerLines" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" tools:listitem="@layout/item_purchase_order_line" />
      </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/invoicePageControls" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp">
        <TextView android:id="@+id/textInvoicePage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/buttonPreviousPage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Previous" android:textAllCaps="false" />
            <Button android:id="@+id/buttonNextPage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Next" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
                <TextView
                    android:id="@+id/textMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/buttonSave" android:enabled="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Save Changes" android:layout_marginEnd="4dp" android:background="@drawable/bg_button_muted" android:textColor="@color/white" />
                    <Button android:id="@+id/buttonReceive" android:enabled="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Receive Order" android:background="@drawable/bg_button_primary" android:textColor="@color/white" />
                </LinearLayout>
</LinearLayout>
