<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="1730dp" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="horizontal" android:background="@drawable/bg_invoice_table_row">
<LinearLayout android:layout_width="84dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textItemCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="230dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textItemName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" android:textStyle="bold"/><TextView android:id="@+id/textItemMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /><TextView android:id="@+id/textWarningBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" android:text="Needs review" android:visibility="gone"/></LinearLayout>
<LinearLayout android:layout_width="120dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="76dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textCurrQty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:layout_width="80dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textUnitsPerCase" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="90dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><EditText android:id="@+id/editQty" android:layout_width="match_parent" android:layout_height="48dp" android:singleLine="true" android:inputType="numberDecimal" android:textSize="14sp" android:contentDescription="Shipped quantity" android:selectAllOnFocus="true" /><TextView android:id="@+id/textQtyType" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="80dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textShippedUnits" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="90dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textCaseCost" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="88dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="90dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textAvgCost" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="100dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><EditText android:id="@+id/editUnitCost" android:layout_width="match_parent" android:layout_height="48dp" android:singleLine="true" android:inputType="numberDecimal" android:textSize="14sp" android:contentDescription="Unit cost" android:selectAllOnFocus="true" /></LinearLayout>
<LinearLayout android:layout_width="110dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><EditText android:id="@+id/editCurrentUnitPrice" android:layout_width="match_parent" android:layout_height="48dp" android:singleLine="true" android:inputType="numberDecimal" android:textSize="14sp" android:contentDescription="Current retail price" android:selectAllOnFocus="true" /></LinearLayout>
<LinearLayout android:layout_width="200dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textPricing" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /><Button android:id="@+id/buttonUseSuggestedPrice" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:text="Use suggested" android:textAllCaps="false" android:textSize="11sp" /></LinearLayout>
<LinearLayout android:layout_width="160dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><TextView android:id="@+id/textMarginBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /><TextView android:id="@+id/textCostIncrease" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#243047" /></LinearLayout>
<LinearLayout android:layout_width="132dp" android:layout_height="wrap_content" android:padding="8dp" android:orientation="vertical"><Button android:id="@+id/buttonReviewScan" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:text="Correct" android:textAllCaps="false" android:textSize="11sp" /><Button android:id="@+id/buttonRemove" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:text="Remove" android:textAllCaps="false" android:textSize="11sp" /></LinearLayout>
</LinearLayout>
