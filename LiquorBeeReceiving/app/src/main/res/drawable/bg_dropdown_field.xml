<?xml version="1.0" encoding="utf-8"?>
<!-- Makes a Spinner visually read as "this is a dropdown" - the plain default Spinner style blends
     into a white background with no visible border, which is exactly why it kept getting missed.
     Paired with an overlay "▾" TextView in the layout (a custom android:background here replaces
     the system Spinner's own built-in arrow asset, so the arrow has to be added back separately). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/white" />
    <stroke android:width="1.5dp" android:color="@color/purple_primary" />
    <corners android:radius="8dp" />
    <padding android:left="12dp" android:top="10dp" android:right="36dp" android:bottom="10dp" />
</shape>
