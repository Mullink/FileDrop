<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">

    <TextView
        android:id="@+id/textPadTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#888888"
        android:gravity="center" />

    <TextView
        android:id="@+id/textPadValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/purple_primary"
        android:background="@drawable/bg_dropdown_field"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/pad1" style="@style/PadButton" android:text="1" />
        <Button android:id="@+id/pad2" style="@style/PadButton" android:text="2" />
        <Button android:id="@+id/pad3" style="@style/PadButton" android:text="3" />
        <Button android:id="@+id/pad4" style="@style/PadButton" android:text="4" />
        <Button android:id="@+id/pad5" style="@style/PadButton" android:text="5" />
        <Button android:id="@+id/pad6" style="@style/PadButton" android:text="6" />
        <Button android:id="@+id/pad7" style="@style/PadButton" android:text="7" />
        <Button android:id="@+id/pad8" style="@style/PadButton" android:text="8" />
        <Button android:id="@+id/pad9" style="@style/PadButton" android:text="9" />
        <Button android:id="@+id/padClear" style="@style/PadButton" android:text="C" android:background="@drawable/bg_button_muted" android:textColor="@color/white" />
        <Button android:id="@+id/pad0" style="@style/PadButton" android:text="0" />
        <Button android:id="@+id/padBackspace" style="@style/PadButton" android:text="⌫" android:background="@drawable/bg_button_muted" android:textColor="@color/white" />
    </GridLayout>

    <Button
        android:id="@+id/padEnter"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:text="Enter"
        android:textSize="18sp"
        android:background="@drawable/bg_button_primary"
        android:textColor="@color/white" />

</LinearLayout>
