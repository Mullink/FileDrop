<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Place an order"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/purple_primary" />
            <TextView
                android:id="@+id/textToggleOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Options ▾"
                android:textSize="13sp"
                android:textColor="@color/purple_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search code, name, UPC" />
            <CheckBox
                android:id="@+id/checkboxScanMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Scan Mode"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Feedback from the last USB barcode scan (Zebra DS4608-SR, SNAPI mode) - which item
             matched and its new cart quantity, or an error if nothing matched. -->
        <TextView
            android:id="@+id/textScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Collapsed by default to leave more room for the catalog list - the account picker
             and filters are occasional-use, the search box is the thing used constantly. -->
        <LinearLayout
            android:id="@+id/groupOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a linked account and place a draft order on their behalf."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <Spinner
                        android:id="@+id/spinnerAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dropdown_field" />
                </FrameLayout>
                <Button
                    android:id="@+id/buttonLoadCatalog"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh Catalog"
                    android:background="@drawable/bg_button_dark"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <CheckBox
                    android:id="@+id/checkboxInStockOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Stock Only" />
                <CheckBox
                    android:id="@+id/checkboxLimitQtyOnHand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limit Qty On Hand"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Column headers - weights must match item_catalog_row.xml exactly. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:text="CODE" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.6" android:text="ITEM" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="QTY ON HAND" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="center" android:text="PENDING SALE" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="AVAILABLE" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="PRICE" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ORDER QTY" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" android:layout_marginHorizontal="6dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:gravity="end" android:text="LINE TOTAL" android:textStyle="bold" android:textSize="11sp" android:textColor="#888888" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCatalog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DEDDD1"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/textCartTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="Cart: 0 items — $0.00" />
            <Button
                android:id="@+id/buttonViewCart"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🛒 View Cart"
                android:background="@drawable/bg_button_dark"
                android:textColor="@color/white" />
            <ProgressBar
                android:id="@+id/progressSubmitting"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:indeterminate="true"
                android:visibility="gone" />
            <Button
                android:id="@+id/buttonSubmitOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit Order"
                android:background="@drawable/bg_button_primary"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Wholesale_OrderPlaced celebration - same DB-driven Giphy GIF + success-overlay modal the
         web shows after a successful order submit (management-place-order.component: dark
         backdrop, white rounded card, GIF, headline, message). Tap to dismiss early, otherwise
         auto-dismisses matching the web's ~4.6s timing. -->
    <FrameLayout
        android:id="@+id/celebrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D1081029"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_modal_card"
            android:padding="24dp"
            android:elevation="8dp">
            <ImageView
                android:id="@+id/imageCelebration"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_dropdown_field" />
            <TextView
                android:id="@+id/textCelebrationHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order placed"
                android:textStyle="bold"
                android:textSize="26sp"
                android:textColor="#0D1F36"
                android:layout_marginTop="16dp" />
            <TextView
                android:id="@+id/textCelebrationMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4F647A"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
