<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-corner white card surface - used for the collapsible PO Details section, the fixed
     Add Items bar, and the item search results panel, so those read as distinct surfaces against
     the (now tinted, not plain white) screen background instead of blending into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/white" />
    <corners android:radius="10dp" />
</shape>
