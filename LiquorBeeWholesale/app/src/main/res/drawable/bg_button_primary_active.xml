<?xml version="1.0" encoding="utf-8"?>
<!-- Same solid navy fill as bg_button_primary.xml, plus a light border ring - used on a toggle's
     currently-selected option so it reads as "active" beyond just its fill color alone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/purple_primary" />
    <stroke android:width="2dp" android:color="@color/white" />
    <corners android:radius="8dp" />
</shape>
