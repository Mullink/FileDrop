<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy_dark">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:background="@color/canvas">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/navy" android:padding="24dp">
                <ImageView android:layout_width="176dp" android:layout_height="176dp"
                    android:layout_gravity="center_horizontal" android:scaleType="fitCenter"
                    android:src="@drawable/brand_logo" android:contentDescription="@string/app_name" />
                <TextView style="@style/BodyText" android:layout_marginTop="10dp"
                    android:text="@string/hero_subtitle" android:gravity="center" android:textColor="@color/card_tint" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp" android:background="@drawable/card">
                    <TextView style="@style/SectionTitle" android:text="@string/pos_heading" />
                    <TextView android:id="@+id/status" style="@style/SectionTitle" android:layout_marginTop="14dp"
                        android:accessibilityLiveRegion="polite" android:textSize="25sp" android:text="@string/ready_to_check" />
                    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp"
                        android:indeterminate="true" android:visibility="gone" />
                    <TextView android:id="@+id/message" style="@style/BodyText" android:layout_marginTop="12dp" android:text="@string/ready_message" />
                    <TextView style="@style/BodyText" android:layout_marginTop="24dp" android:textSize="12sp"
                        android:letterSpacing="0.06" android:text="@string/installed_label" />
                    <TextView android:id="@+id/installed_version" style="@style/SectionTitle"
                        android:layout_marginTop="5dp" android:text="@string/not_available" />
                    <TextView style="@style/BodyText" android:layout_marginTop="18dp" android:textSize="12sp"
                        android:letterSpacing="0.06" android:text="@string/published_label" />
                    <TextView android:id="@+id/published_version" style="@style/SectionTitle"
                        android:layout_marginTop="5dp" android:text="@string/not_available" />
                    <TextView android:id="@+id/last_checked" style="@style/BodyText" android:layout_marginTop="18dp"
                        android:textSize="13sp" android:text="@string/not_checked" />
                    <Button android:id="@+id/check_button" style="@style/SecondaryButton" android:layout_marginTop="16dp" android:text="@string/check_now" />
                    <Button android:id="@+id/download_button" style="@style/ActionButton" android:text="@string/download_pos" />
                    <Button android:id="@+id/later_button" style="@style/SecondaryButton" android:text="@string/later" android:visibility="gone" />
                    <TextView style="@style/BodyText" android:layout_marginTop="10dp" android:textSize="13sp" android:text="@string/download_note" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card">
                    <TextView style="@style/SectionTitle" android:text="@string/background_title" />
                    <Switch android:id="@+id/background_switch" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:text="@string/background_switch" android:textSize="16sp"
                        android:textColor="@color/ink" android:switchPadding="16dp" android:layout_marginTop="10dp" />
                    <TextView android:id="@+id/schedule_description" style="@style/BodyText" android:text="@string/schedule_enabled" />
                    <TextView android:id="@+id/scheduled_result" style="@style/BodyText"
                        android:layout_marginTop="12dp" android:text="@string/no_scheduled_result" />
                    <Button android:id="@+id/daily_time_button" style="@style/SecondaryButton"
                        android:layout_marginTop="8dp" android:text="@string/change_daily_time" />
                    <TextView style="@style/BodyText" android:text="@string/daily_timezone" />
                    <Button android:id="@+id/alarm_permission_button" style="@style/SecondaryButton"
                        android:layout_marginTop="8dp" android:text="@string/alarm_permission_button" />
                    <Switch android:id="@+id/daily_switch" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:text="@string/daily_switch" android:textSize="16sp"
                        android:textColor="@color/ink" android:switchPadding="16dp" android:layout_marginTop="16dp" />
                    <TextView android:id="@+id/daily_description" style="@style/BodyText" android:text="@string/daily_permission_needed" />
                    <Button android:id="@+id/daily_permission_button" style="@style/SecondaryButton"
                        android:layout_marginTop="8dp" android:text="@string/daily_permission_button" />
                    <TextView android:id="@+id/notification_description" style="@style/BodyText"
                        android:layout_marginTop="16dp" android:text="@string/notifications_off" />
                    <Button android:id="@+id/notification_button" style="@style/SecondaryButton"
                        android:layout_marginTop="8dp" android:text="@string/enable_notifications" />
                    <TextView style="@style/BodyText" android:layout_marginTop="12dp"
                        android:textSize="13sp" android:text="@string/force_stop_note" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card">
                    <TextView style="@style/SectionTitle" android:text="@string/release_source" />
                    <TextView style="@style/BodyText" android:layout_marginTop="10dp" android:text="@string/release_description" />
                    <Button android:id="@+id/source_button" style="@style/SecondaryButton"
                        android:layout_marginTop="10dp" android:text="@string/view_version_file" />
                </LinearLayout>
                <TextView style="@style/BodyText" android:layout_marginTop="24dp" android:textSize="13sp"
                    android:gravity="center" android:text="@string/footer" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
